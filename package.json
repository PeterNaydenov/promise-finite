{
  "name": "promise-finite",
  "description": "Promise with ttl",
  "version": "2.0.1",
  "license": "MIT",
  "author": "Peter Naydenov",
  "main": "./dist/promise-finite.umd.js",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/promise-finite.esm.mjs",
      "require": "./dist/promise-finite.cjs",
      "default": "./dist/promise-finite.umd.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*",
    "./README.md": "./README.md"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "cover": "vitest run --coverage",
    "build": "rollup -c"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeterNaydenov/promise-finite.git"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "bluebird": "3.7.2",
    "rollup": "^4.62.5",
    "vitest": "^4.1.11"
  },
  "directories": {
    "test": "vitest test"
  },
  "keywords": [
    "promise",
    "timeout",
    "ttl"
  ],
  "bugs": {
    "url": "https://github.com/PeterNaydenov/promise-finite/issues"
  },
  "homepage": "https://github.com/PeterNaydenov/promise-finite#readme",
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
